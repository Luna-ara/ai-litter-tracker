# Copy to .env.local and fill in. Never commit .env.local.

# Database
DATABASE_URL=file:local.db

# Auth: generate with `openssl rand -base64 32`
AUTH_SECRET=dev-only-secret-replace-me-0123456789abcdef

# App URL, used for Stripe redirects. Set to the tunnel URL when demoing on a phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe TEST keys (Luna shares by DM). Leave blank for simulated payments.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Connect test account (acct_...) for the demo citizen
DEMO_CITIZEN_STRIPE_ACCOUNT_ID=
